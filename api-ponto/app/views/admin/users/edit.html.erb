<% content_for :page_title, "Editar Usuário" %>

<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <div class="card card-primary card-outline">
      <div class="card-header">
        <h3 class="card-title"><i class="fas fa-pencil me-1"></i> Editar Usuário — <%= @user.nome_completo %></h3>
      </div>
      <div class="card-body">
        <% bloqueado = @user.cpf.present? %>

        <% if bloqueado %>
          <div class="alert alert-info">
            <i class="fas fa-circle-info me-1"></i>
            Este frequentador está vinculado ao Pessoas — os dados cadastrais vêm de lá e não podem ser editados manualmente aqui. Para atualizar, use o botão "Reimportar do Pessoas" na listagem de frequentadores.
          </div>
        <% end %>

        <%= form_with(model: @user, local: true) do |f| %>
          <% if @user.errors.any? %>
            <div class="alert alert-danger">
              <h6><%= pluralize(@user.errors.count, "erro") %> ao salvar:</h6>
              <ul class="mb-0">
                <% @user.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= f.label :nome_completo, class: "form-label" %>
            <%= f.text_field :nome_completo, class: "form-control", disabled: bloqueado %>
          </div>

          <div class="mb-3">
            <label class="form-label">Username</label>
            <input type="text" class="form-control" value="<%= @user.username %>" disabled>
            <div class="form-text">Username não pode ser alterado.</div>
          </div>

          <div class="mb-3">
            <%= f.label :password, class: "form-label" %>
            <%= f.password_field :password, class: "form-control", placeholder: "Deixe em branco para manter a atual", disabled: bloqueado %>
          </div>

          <div class="mb-3">
            <%= f.label :password_confirmation, class: "form-label" %>
            <%= f.password_field :password_confirmation, class: "form-control", placeholder: "Confirme a nova senha", disabled: bloqueado %>
          </div>

          <div class="mb-3">
            <%= f.label :status, class: "form-label" %>
            <%= f.select :status, [["Ativo", 1], ["Inativo", 0]], {}, class: "form-select", disabled: bloqueado %>
          </div>

          <div class="mb-3">
            <%= f.label :digitais_hash, class: "form-label" %>
            <%= f.text_area :digitais_hash, class: "form-control", rows: 3, disabled: bloqueado %>
          </div>

          <div class="d-flex gap-2">
            <% unless bloqueado %>
              <%= f.submit "Salvar", class: "btn btn-primary" %>
            <% end %>
            <%= link_to "Cancelar", users_path, class: "btn btn-outline-secondary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
