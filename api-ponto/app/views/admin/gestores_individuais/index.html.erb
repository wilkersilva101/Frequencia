<% content_for :page_title, "Gestores Individuais" %>

<div class="row mb-3">
  <div class="col-sm-6">
    <p class="text-muted mb-0"><%= @gestores.size %> gestor(es) cadastrado(s)</p>
  </div>
</div>

<div class="card card-primary card-outline">
  <div class="card-header">
    <h3 class="card-title"><i class="fas fa-id-badge me-1"></i> Lista de Gestores Individuais</h3>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-striped mb-0">
        <thead>
          <tr>
            <th>Nome</th>
            <th>Órgão</th>
            <th>Gerenciados</th>
          </tr>
        </thead>
        <tbody>
          <% @gestores.each do |gestor| %>
            <tr>
              <td><%= gestor.nome %></td>
              <td><%= gestor.orgao %></td>
              <td><%= gestor.gerenciados.size %></td>
            </tr>
          <% end %>
          <% if @gestores.empty? %>
            <tr><td colspan="3" class="text-muted text-center">Nenhum gestor cadastrado</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
