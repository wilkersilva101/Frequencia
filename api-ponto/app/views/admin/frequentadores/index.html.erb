<% content_for :page_title, "Gerência de Frequentadores" %>
<% content_for :page_actions do %>
  <%= link_to "Cadastrar novo frequentador", "#" %>
  <%= button_to "Importar servidores da unidade piloto", importar_unidade_frequentadores_path, method: :post, class: "btn btn-outline-primary btn-sm", form: { data: { turbo: false } } %>
<% end %>

<div class="row mb-3">
  <div class="col-sm-6">
    <p class="text-muted mb-0"><%= @vinculos.total_count %> frequentador(es)<%= " (incluindo inativos)" if params[:inativos].present? %></p>
  </div>
</div>

<div class="card card-primary card-outline mb-4">
  <div class="card-header">
    <h3 class="card-title"><i class="fas fa-filter me-1"></i> Filtros</h3>
  </div>
  <div class="card-body">
    <%= form_tag frequentadores_path, method: :get, class: "row g-2 align-items-end", data: { turbo: false } do %>
      <div class="col-auto">
        <%= label_tag :nome, "Nome", class: "form-label" %>
        <%= text_field_tag :nome, params[:nome], class: "form-control form-control-sm", placeholder: "Buscar por nome" %>
      </div>
      <div class="col-auto">
        <%= label_tag :orgao, "Órgão", class: "form-label" %>
        <%= text_field_tag :orgao, params[:orgao], class: "form-control form-control-sm", placeholder: "Buscar por órgão" %>
      </div>
      <div class="col-auto">
        <%= label_tag :categoria, "Categoria", class: "form-label" %>
        <%= select_tag :categoria,
              options_for_select(@categorias_trabalhador.map { |c| [c.descricao, c.id] }, params[:categoria]),
              include_blank: "Todos",
              class: "form-select form-select-sm" %>
      </div>
      <div class="col-auto">
        <%= label_tag :digital, "Digital", class: "form-label" %>
        <%= select_tag :digital,
              options_for_select([["Com Digital", "1"], ["Sem Digital", "0"]], params[:digital]),
              include_blank: "Todas",
              class: "form-select form-select-sm" %>
      </div>
      <div class="col-auto d-flex align-items-center gap-3 pb-1">
        <div class="form-check">
          <%= check_box_tag :sem_digital, "1", params[:sem_digital].present?, class: "form-check-input", id: "sem_digital" %>
          <%= label_tag :sem_digital, "Digital não cadastrada", class: "form-check-label" %>
        </div>
        <div class="form-check">
          <%= check_box_tag :inativos, "1", params[:inativos].present?, class: "form-check-input", id: "inativos" %>
          <%= label_tag :inativos, "Frequentadores inativos", class: "form-check-label" %>
        </div>
      </div>
      <div class="col-auto d-flex gap-1">
        <%= button_tag class: "btn btn-primary btn-sm" do %>
          <i class="fas fa-magnifying-glass"></i> Filtrar
        <% end %>
        <%= link_to frequentadores_path, class: "btn btn-outline-secondary btn-sm" do %>
          <i class="fas fa-xmark"></i> Limpar
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div class="card card-primary card-outline">
  <div class="card-header">
    <h3 class="card-title"><i class="fas fa-user-check me-1"></i> Lista de Frequentadores</h3>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle mb-0">
        <thead>
          <tr>
            <th style="width: 30%">Nome</th>
            <th style="width: 18%">Comarca/Órgão</th>
            <th style="width: 16%">Vínculo</th>
            <th style="width: 11%">Status</th>
            <th style="width: 11%">Digital</th>
            <th class="text-end" style="width: 14%">Gerência</th>
          </tr>
        </thead>
        <tbody>
          <% @vinculos.each do |vinculo| %>
            <% user = @user_por_cpf[vinculo.pessoa&.cpf] %>
            <tr>
              <td><%= vinculo.pessoa&.nome %></td>
              <% unidade = @unidade_por_vinculo_id[vinculo.id] %>
              <% if unidade&.descricao.present? %>
                <td><%= unidade.descricao %></td>
              <% else %>
                <td class="text-muted">—</td>
              <% end %>
              <% if vinculo.tipo_vinculo&.nome.present? %>
                <td><%= vinculo.tipo_vinculo.nome %></td>
              <% else %>
                <td class="text-muted">—</td>
              <% end %>
              <td>
                <% if user.nil? %>
                  <span class="badge text-bg-secondary" title="Vínculo ativo no Pessoas, sem cadastro local no Frequencia">Sem cadastro local</span>
                <% elsif user.status == 1 %>
                  <span class="badge text-bg-success">Ativo</span>
                <% else %>
                  <span class="badge text-bg-danger">Inativo</span>
                <% end %>
              </td>
              <td>
                <% if user.nil? %>
                  <span class="text-muted">—</span>
                <% elsif user.digitais_hash.present? %>
                  <span class="badge text-bg-info">Cadastrada</span>
                <% else %>
                  <span class="badge text-bg-secondary">Não</span>
                <% end %>
              </td>
              <td class="text-end">
                <div class="d-flex gap-1 justify-content-end">
                  <% if user.nil? %>
                    <span class="btn btn-xs btn-outline-secondary disabled" title="Sem cadastro local — cadastro a partir do Pessoas ainda não implementado">
                      <i class="fas fa-user-plus"></i>
                    </span>
                  <% else %>
                    <% if user.cpf.present? %>
                      <%= button_to reimportar_dados_pessoa_frequentador_path(user), method: :post, class: "btn btn-xs btn-outline-secondary", title: "Reimportar do Pessoas" do %>
                        <i class="fas fa-rotate"></i>
                      <% end %>
                    <% end %>
                    <%= link_to edit_user_path(user), class: "btn btn-xs btn-outline-primary", title: "Editar" do %>
                      <i class="fas fa-pencil"></i>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
          <% if @vinculos.empty? %>
            <tr><td colspan="6" class="text-muted text-center">Nenhum frequentador encontrado</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="card-footer clearfix">
    <div class="float-start pt-1 fs-7 text-body-secondary">
      <% if @vinculos.any? %>
        Mostrando <%= @vinculos.offset_value + 1 %> a <%= @vinculos.offset_value + @vinculos.length %> de <%= @vinculos.total_count %> frequentadores
      <% end %>
    </div>
    <%= paginate @vinculos %>
  </div>
</div>
