<% content_for :page_title, "Editar Estação" %>

<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <div class="card card-primary card-outline">
      <div class="card-header">
        <h3 class="card-title"><i class="fas fa-pencil me-1"></i> Editar Estação — <%= @estacao.descricao %></h3>
      </div>
      <div class="card-body">
        <%= render "form", url: estacao_path(@estacao), submit_label: "Salvar" %>
      </div>
    </div>
  </div>
</div>
