<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>API Ponto TJPI</title>

  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#007bff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)" />

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Fonts -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/source-sans-3@5.0.12/index.css" crossorigin="anonymous" media="print" onload="this.media='all'" />

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />

  <!-- AdminLTE 4 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0/dist/css/adminlte.min.css" crossorigin="anonymous" />

  <!-- OverlayScrollbars -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/styles/overlayscrollbars.min.css" crossorigin="anonymous" />

  <%= stylesheet_link_tag "application" %>
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">

<div class="app-wrapper">

  <!-- App Header (Navbar) -->
  <nav class="app-header navbar navbar-expand bg-body">
    <div class="container-fluid">
      <!-- Left navbar links -->
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Toggle sidebar">
            <i class="bi bi-list"></i>
          </a>
        </li>
        <li class="nav-item d-none d-md-block">
          <%= link_to root_path, class: "nav-link" do %>
            <i class="bi bi-grid-1x2 me-1" aria-hidden="true"></i>
            Dashboard
          <% end %>
        </li>
      </ul>

      <!-- Right navbar links -->
      <ul class="navbar-nav ms-auto">
        <% if session[:user_id] %>
          <li class="nav-item dropdown user-menu">
            <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-label="Menu do usuário">
              <span class="d-none d-md-inline"><%= current_user&.nome_completo %></span>
            </a>
            <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
              <li class="user-header text-bg-primary">
                <p>
                  <%= current_user&.nome_completo %>
                  <small><%= current_user&.admin? ? "Administrador" : "Usuário" %></small>
                </p>
              </li>
              <li class="user-footer">
                <%= button_to "Sair", logout_path, method: :delete, class: "btn btn-outline-danger w-100", data: { turbo: false } %>
              </li>
            </ul>
          </li>
        <% end %>
      </ul>
    </div>
  </nav>
  <!-- /.app-header -->

  <!-- App Sidebar -->
  <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
    <div class="sidebar-brand">
      <%= link_to root_path, class: "brand-link" do %>
        <span class="brand-text fw-light">API Ponto TJPI</span>
      <% end %>
    </div>

    <div class="sidebar-wrapper">
      <nav class="mt-2" aria-label="Navegação principal">
        <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" data-accordion="false">
          <li class="nav-item">
            <%= link_to dashboard_path, class: "nav-link#{" active" if current_page?(dashboard_path) || current_page?(root_path) }" do %>
              <i class="nav-icon bi bi-speedometer"></i>
              <p>Dashboard</p>
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to time_records_path, class: "nav-link#{" active" if current_page?(time_records_path) }" do %>
              <i class="nav-icon bi bi-clock-history"></i>
              <p>Registros de Ponto</p>
            <% end %>
          </li>
          <% if current_user&.admin? %>
            <li class="nav-item">
              <%= link_to users_path, class: "nav-link#{" active" if current_page?(users_path) }" do %>
                <i class="nav-icon bi bi-people"></i>
                <p>Usuários</p>
              <% end %>
            </li>
          <% end %>
          <li class="nav-item">
            <a href="#" class="nav-link">
              <i class="nav-icon bi bi-person-check"></i>
              <p>
                Presença
                <i class="nav-arrow bi bi-chevron-right"></i>
              </p>
            </a>
            <ul class="nav nav-treeview">
              <li class="nav-item">
                <%= link_to frequentadores_path, class: "nav-link#{" active" if current_page?(frequentadores_path) }" do %>
                  <i class="nav-icon bi bi-circle"></i>
                  <p>Frequentadores</p>
                <% end %>
              </li>
              <li class="nav-item">
                <a href="#" class="nav-link">
                  <i class="nav-icon bi bi-circle"></i>
                  <p>
                    Estação de Ponto
                    <i class="nav-arrow bi bi-chevron-right"></i>
                  </p>
                </a>
                <ul class="nav nav-treeview">
                  <li class="nav-item">
                    <a href="#" class="nav-link">
                      <i class="nav-icon bi bi-circle"></i>
                      <p>Inicializar Estação</p>
                    </a>
                  </li>
                  <li class="nav-item">
                    <%= link_to estacoes_path, class: "nav-link#{" active" if current_page?(estacoes_path) }" do %>
                      <i class="nav-icon bi bi-circle"></i>
                      <p>Explorar Estações</p>
                    <% end %>
                  </li>
                  <li class="nav-item">
                    <%= link_to versoes_path, class: "nav-link#{" active" if current_page?(versoes_path) }" do %>
                      <i class="nav-icon bi bi-circle"></i>
                      <p>Explorar Versões</p>
                    <% end %>
                  </li>
                </ul>
              </li>
              <li class="nav-item">
                <a href="#" class="nav-link">
                  <i class="nav-icon bi bi-circle"></i>
                  <p>
                    Relatório Mensal
                    <i class="nav-arrow bi bi-chevron-right"></i>
                  </p>
                </a>
                <ul class="nav nav-treeview">
                  <li class="nav-item">
                    <%= link_to relatorio_terceirizados_path, class: "nav-link#{" active" if current_page?(relatorio_terceirizados_path) }" do %>
                      <i class="nav-icon bi bi-circle"></i>
                      <p>Relatório Terceirizados</p>
                    <% end %>
                  </li>
                  <li class="nav-item">
                    <%= link_to frequencia_por_orgao_path, class: "nav-link#{" active" if current_page?(frequencia_por_orgao_path) }" do %>
                      <i class="nav-icon bi bi-circle"></i>
                      <p>Frequência por Órgão</p>
                    <% end %>
                  </li>
                  <li class="nav-item">
                    <%= link_to parcial_path, class: "nav-link#{" active" if current_page?(parcial_path) }" do %>
                      <i class="nav-icon bi bi-circle"></i>
                      <p>Parcial</p>
                    <% end %>
                  </li>
                </ul>
              </li>
              <li class="nav-item">
                <%= link_to frequencia_path, class: "nav-link#{" active" if current_page?(frequencia_path) }" do %>
                  <i class="nav-icon bi bi-circle"></i>
                  <p>Frequência</p>
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to regimes_path, class: "nav-link#{" active" if current_page?(regimes_path) }" do %>
                  <i class="nav-icon bi bi-circle"></i>
                  <p>Regimes</p>
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to direitos_deveres_path, class: "nav-link#{" active" if current_page?(direitos_deveres_path) }" do %>
                  <i class="nav-icon bi bi-circle"></i>
                  <p>Direitos &amp; Deveres</p>
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to gestores_individuais_path, class: "nav-link#{" active" if current_page?(gestores_individuais_path) }" do %>
                  <i class="nav-icon bi bi-circle"></i>
                  <p>Gestores Individuais</p>
                <% end %>
              </li>
            </ul>
          </li>
          <%= render "layouts/sistema/configuracoes_nav" %>
        </ul>
      </nav>
    </div>
  </aside>
  <!-- /.app-sidebar -->

  <!-- App Main -->
  <main class="app-main">
    <!-- App Content Header -->
    <div class="app-content-header">
      <div class="container-fluid">
        <div class="row">
          <div class="col-sm-6">
            <h1 class="mb-0 fs-3"><%= yield :page_title %></h1>
          </div>
          <div class="col-sm-6 d-flex align-items-center justify-content-end">
            <%= yield :page_actions %>
          </div>
        </div>
      </div>
    </div>
    <!-- /.app-content-header -->

    <!-- App Content -->
    <div class="app-content">
      <div class="container-fluid">
        <% if flash[:notice] %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= flash[:notice] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= flash[:alert] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>
        <%= yield %>
      </div>
    </div>
    <!-- /.app-content -->
  </main>
  <!-- /.app-main -->

  <!-- Footer -->
  <footer class="app-footer">
    <div class="float-end d-none d-sm-inline">
      <strong>API Ponto TJPI</strong>
    </div>
    <span>&copy; <%= Time.current.year %> Tribunal de Justiça do Piauí</span>
  </footer>

</div>
<!-- /.app-wrapper -->

<%= javascript_importmap_tags "application" %>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Sidebar state persistence
  var savedState = localStorage.getItem('admin-sidebar-collapsed');
  if (savedState === 'true') {
    document.body.classList.add('sidebar-collapse');
  }
  var toggleBtn = document.querySelector('[data-lte-toggle="sidebar"]');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', function() {
      setTimeout(function() {
        var isCollapsed = document.body.classList.contains('sidebar-collapse');
        localStorage.setItem('admin-sidebar-collapsed', isCollapsed);
      }, 300);
    });
  }

  // Active menu highlight for sidebar
  var currentPath = window.location.pathname;
  document.querySelectorAll('.sidebar-menu a.nav-link').forEach(function(link) {
    if (link.getAttribute('href') === currentPath) {
      link.classList.add('active');
    }
  });
});
</script>
</body>
</html>
